<UserControl x:Class="GitPort.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Overlay" Focusable="False"
             AutomationProperties.Name="Operation in progress">
    <Grid Background="#40152438" Cursor="Wait">
        <Border Background="#E61E324C" BorderBrush="#603B557A" BorderThickness="1"
                CornerRadius="12" Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="460">
            <StackPanel>
                <Grid Width="32" Height="32" Margin="0,0,0,12">
                    <Ellipse Stroke="#3B557A" StrokeThickness="3"/>
                    <Path x:Name="Spinner" Stroke="#00B8E5" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 16,1.5 A 14.5,14.5 0 0 1 30.5,16" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock Text="{Binding Message, ElementName=Overlay}" Foreground="#E6EEF8"
                           FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
