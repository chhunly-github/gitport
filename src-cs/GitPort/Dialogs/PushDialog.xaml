<Window x:Class="GitPort.Dialogs.PushDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GitPort.Models"
        Title="Push Commits" Height="580" Width="860"
        MinHeight="450" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#152438" Foreground="#E6EEF8"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GitPort;component/Themes/WebStormTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Branch & Remote Config Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main WebStorm Commits & Details Inspector -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Footer / Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Branch & Remote Configuration Header -->
        <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Source Branch Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬆ " Foreground="#00B8E5" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Local:" Foreground="#8FA8C4" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border Background="#152438" BorderBrush="#00B8E5" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="TxtLocalBranch" Text="main" Foreground="#00B8E5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Arrow -->
                <TextBlock Grid.Column="1" Text=" ➔ " Foreground="#8FA8C4" FontSize="14" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>

                <!-- Target Remote & Branch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Remote:" Foreground="#8FA8C4" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CboRemote" Width="100" Height="26" Margin="0,0,6,0"
                              Background="#152438" Foreground="#E6EEF8" BorderBrush="#293E5C"
                              SelectionChanged="OnRemoteSelectionChanged"/>
                    <TextBlock Text=":" Foreground="#8FA8C4" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTargetBranch" Width="140" Height="26" Style="{StaticResource WebStormSearchBox}"/>
                </StackPanel>

                <!-- Outgoing Commits Badge -->
                <Border Grid.Column="5" x:Name="BadgeCommitCount" Background="#1B3454" BorderBrush="#00B8E5" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦 " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCommitCountBadge" Text="Calculating commits..." Foreground="#00B8E5" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 1: Split Content: Outgoing Commits List + Selected Commit File Inspector -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left Pane: Outgoing Commits -->
                <ColumnDefinition Width="400" MinWidth="260"/>
                <!-- Splitter -->
                <ColumnDefinition Width="6"/>
                <!-- Right Pane: Commit Details & Files -->
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Outgoing Commits List -->
            <Border Grid.Column="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="OUTGOING COMMITS TO PUSH" FontWeight="Bold" FontSize="11" Foreground="#8FA8C4" Margin="0,0,0,8"/>

                    <ListView x:Name="OutgoingCommitsListView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              SelectionMode="Single" SelectionChanged="OnOutgoingCommitSelected"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,4"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemBorder" Background="#152438" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#243A59"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1E518A"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00B8E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GitCommitItem}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Short Hash -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#152438" CornerRadius="2" Padding="4,1" Margin="0,0,6,2">
                                        <TextBlock Text="{Binding ShortHash}" Foreground="#00B8E5" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Subject -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subject}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Author & Date -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Author}" Foreground="#8FA8C4" FontSize="10" Margin="0,0,8,0"/>
                                        <TextBlock Text="•" Foreground="#5274A3" FontSize="10" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Date}" Foreground="#8FA8C4" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State / Up to date notification -->
                    <Border x:Name="PanelUpToDate" Grid.Row="1" Background="#152438" CornerRadius="4" Visibility="Collapsed" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="✔ Everything is up to date" FontSize="14" FontWeight="SemiBold" Foreground="#7EC7A6" HorizontalAlignment="Center"/>
                            <TextBlock Text="No outgoing commits to push for this branch." FontSize="11" Foreground="#8FA8C4" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- RIGHT: Commit Details & Files Changed -->
            <Border Grid.Column="2" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Commit Details Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Files Changed List Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Files Changed ListView -->
                        <RowDefinition Height="*"/>
                        <!-- Diff Actions -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Commit Info -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtDetailSubject" Text="Select a commit to view details" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Author:" Foreground="#8FA8C4" FontSize="11" Width="50"/>
                            <TextBlock x:Name="TxtDetailAuthor" Grid.Column="1" Text="" Foreground="#E6EEF8" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date:" Foreground="#8FA8C4" FontSize="11" Width="50"/>
                            <TextBlock x:Name="TxtDetailDate" Grid.Column="1" Text="" Foreground="#E6EEF8" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hash:" Foreground="#8FA8C4" FontSize="11" Width="50"/>
                            <TextBlock x:Name="TxtDetailHash" Grid.Column="1" Text="" Foreground="#00B8E5" FontFamily="Consolas, monospace" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#293E5C" Margin="0,0,0,8"/>

                    <!-- Files Changed ListView -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TxtFilesHeader" Text="CHANGED FILES (0)" FontWeight="Bold" FontSize="11" Foreground="#8FA8C4" Margin="0,0,0,6"/>

                        <ListView x:Name="CommitFilesListView" Grid.Row="1" Background="#152438" BorderBrush="#293E5C" BorderThickness="1"
                                  MouseDoubleClick="OnCommitFileDoubleClicked">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <!-- Status Badge -->
                                        <Border CornerRadius="2" Padding="4,1" Margin="0,0,6,0" Width="18">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E324C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="M">
                                                            <Setter Property="Background" Value="#1B3454"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="A">
                                                            <Setter Property="Background" Value="#1A3D34"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="D">
                                                            <Setter Property="Background" Value="#3D1E24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8FA8C4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="M">
                                                                <Setter Property="Foreground" Value="#00B8E5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="A">
                                                                <Setter Property="Foreground" Value="#7EC7A6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="D">
                                                                <Setter Property="Foreground" Value="#F48771"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Path}" Foreground="#E6EEF8" FontFamily="Consolas, monospace" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- View Diff Button -->
                    <Button Grid.Row="3" Content="🔍 View Full Commit Diff..." Style="{StaticResource WebStormGhostButton}" 
                            Click="OnViewCommitDiffClicked" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: Footer / Push Options and Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Options -->
                <ColumnDefinition Width="Auto"/>
                <!-- Status Message -->
                <ColumnDefinition Width="*"/>
                <!-- Actions -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Options Checkboxes -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ChkPushTags" Content="Push tags (--tags)" Foreground="#E6EEF8" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkForceWithLease" Content="Force push (--force-with-lease)" Foreground="#FF943D" VerticalAlignment="Center"
                          ToolTip="Safely force-pushes only if remote branch matches your expected state."/>
            </StackPanel>

            <!-- Status Message -->
            <TextBlock x:Name="TxtStatusMessage" Grid.Column="1" Text="" Foreground="#00B8E5" FontSize="11" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource WebStormGhostButton}" 
                        IsCancel="True" Click="OnCancelClicked" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="BtnPush" Content="Push" Style="{StaticResource WebStormPrimaryButton}" 
                        IsDefault="True" Click="OnPushClicked" Padding="18,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
