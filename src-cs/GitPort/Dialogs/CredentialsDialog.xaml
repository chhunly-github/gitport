<Window x:Class="GitPort.Dialogs.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve Git Connection" Height="740" Width="650" MinHeight="450" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="#152438" Foreground="#E6EEF8"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GitPort;component/Themes/WebStormTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtProviderIcon" FontSize="20" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTitle" Text="Resolve Git Connection" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <Border Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtProviderName" Foreground="#00B8E5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtProviderHint" Foreground="#8FA8C4" TextWrapping="Wrap" Margin="0,6,0,10"/>
                        <TextBlock Text="Repository clone URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRemoteUrl" Style="{StaticResource WebStormSearchBox}" TextChanged="OnRemoteUrlChanged"
                                 ToolTip="Check the owner and repository path. URL changes are saved when you continue."/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Open repository" Click="OnOpenRepository" Style="{StaticResource WebStormGhostButton}" Margin="0,0,8,4"/>
                            <Button Content="Copy link" Click="OnCopyLink" Style="{StaticResource WebStormGhostButton}" Margin="0,0,8,4"/>
                            <Button Content="Get access token" Click="OnOpenTokenPage" Style="{StaticResource WebStormGhostButton}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <Border x:Name="BannerSslAlert" Background="#3D2918" CornerRadius="4" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Certificate verification failed. Check the server certificate. A bypass is available below for this remote."
                                       Foreground="#FFB870" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TxtRecoveryHint" Foreground="#E6EEF8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtConnectionError" IsReadOnly="True" TextWrapping="Wrap" Height="85" Visibility="Collapsed"
                         VerticalScrollBarVisibility="Auto" Foreground="#F48771" Background="#152438" BorderBrush="#293E5C" Margin="0,0,0,12"/>
                <StackPanel x:Name="SavedAccountPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Reuse a saved account on this server:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SavedAccounts" Height="30" SelectionChanged="OnSavedAccountChanged"/>
                    <TextBlock Text="Remember also pins this profile to this repository." Foreground="#8FA8C4" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="CredentialInputs">
                    <Button x:Name="BtnBrowserLogin" Content="Sign in with browser" Click="OnBrowserLogin" HorizontalAlignment="Left"
                            Style="{StaticResource WebStormPrimaryButton}" Padding="14,7" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtBrowserHint" Foreground="#8FA8C4" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Username / Account" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUsername" Style="{StaticResource WebStormSearchBox}" Height="30" Margin="0,0,0,12"/>
                    <TextBlock Text="Password / Access token" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtPassword" Background="#152438" Foreground="#E6EEF8" BorderBrush="#293E5C" BorderThickness="1" Padding="6,4" Height="30"/>
                        <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource WebStormSearchBox}" Height="30" Visibility="Collapsed"/>
                        <Button Grid.Column="1" x:Name="BtnTogglePassword" Content="Show" Click="OnTogglePasswordVisibility" Style="{StaticResource WebStormGhostButton}" Margin="4,0,0,0"/>
                        <Button Grid.Column="2" Content="Paste" Click="OnPastePassword" Style="{StaticResource WebStormGhostButton}" Margin="4,0,0,0"/>
                    </Grid>
                    <CheckBox x:Name="ChkRemember" Content="Remember encrypted login (current Windows user)" Foreground="#E6EEF8" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkDisableSslVerify" Content="Skip certificate verification for this remote (unsafe)" Foreground="#8FA8C4"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="TxtValidationMessage" Foreground="#F48771" FontSize="11" TextWrapping="Wrap" Margin="0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource WebStormGhostButton}" IsCancel="True" Click="OnCancelClicked" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="BtnLogin" Content="Save &amp; Retry" Style="{StaticResource WebStormPrimaryButton}" IsDefault="True" Click="OnLoginClicked" Padding="16,6"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
