<Window x:Class="GitPort.Dialogs.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git Authentication" Height="490" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#152438" Foreground="#E6EEF8"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GitPort;component/Themes/WebStormTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Remote & Provider Card -->
            <RowDefinition Height="Auto"/>
            <!-- Credentials Inputs -->
            <RowDefinition Height="*"/>
            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtProviderIcon" Text="🔑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Text="Git Authentication Required" FontSize="16" FontWeight="SemiBold" Foreground="#E6EEF8" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Enter authentication credentials for the remote Git repository." 
                       FontSize="11" Foreground="#8FA8C4" Margin="28,2,0,0"/>
        </StackPanel>

        <!-- Remote & Provider Info Card -->
        <Border Grid.Row="1" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Provider:" Foreground="#8FA8C4" FontWeight="SemiBold" FontSize="11" Width="70" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="#152438" BorderBrush="#00B8E5" BorderThickness="1" CornerRadius="3" Padding="6,2">
                        <TextBlock x:Name="TxtProviderName" Text="Git Server" Foreground="#00B8E5" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Remote URL:" Foreground="#8FA8C4" FontWeight="SemiBold" FontSize="11" Width="70" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRemoteUrl" Grid.Column="1" Text="https://..." Foreground="#E6EEF8" 
                               FontFamily="Consolas, monospace" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Provider Tip / Advice -->
                <TextBlock x:Name="TxtProviderHint" Text="For GitHub and GitLab, personal access tokens are required. Account passwords are not supported." 
                           Foreground="#8FA8C4" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                <!-- SSL Alert Banner (visible if self-signed SSL issue) -->
                <Border x:Name="BannerSslAlert" Background="#3D2918" BorderBrush="#FF943D" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="⚠ Self-signed SSL certificate detected. Enable the SSL certificate bypass option below to allow connecting to this server." 
                               Foreground="#FFB870" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Credentials Inputs -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <!-- Username -->
            <TextBlock Text="Username / Account:" Foreground="#E6EEF8" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Style="{StaticResource WebStormSearchBox}" Height="30" Margin="0,0,0,12"/>

            <!-- Password / Token -->
            <TextBlock Text="Password / Personal Access Token:" Foreground="#E6EEF8" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="TxtPassword" Background="#152438" Foreground="#E6EEF8" BorderBrush="#293E5C" BorderThickness="1" 
                             Padding="6,4" Height="30" PasswordChar="●"/>
                <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource WebStormSearchBox}" Height="30" Visibility="Collapsed"/>
                <Button Grid.Column="1" x:Name="BtnTogglePassword" Content="👁" Style="{StaticResource WebStormGhostButton}" 
                        Click="OnTogglePasswordVisibility" Margin="4,0,0,0" Height="30" Width="32" ToolTip="Show / Hide Password"/>
            </Grid>

            <!-- Options Checkboxes -->
            <CheckBox x:Name="ChkRemember" Content="Remember encrypted login in this profile (current Windows user)"
                      IsChecked="True" Foreground="#E6EEF8" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkDisableSslVerify" Content="Skip certificate verification for this remote (unsafe)"
                      Foreground="#8FA8C4" Margin="0,0,0,0"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtValidationMessage" Grid.Column="0" Text="" Foreground="#F48771" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>

            <Button Grid.Column="1" x:Name="BtnCancel" Content="Cancel" Style="{StaticResource WebStormGhostButton}" 
                    IsCancel="True" Click="OnCancelClicked" Padding="14,6" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="BtnLogin" Content="Log In &amp; Continue" Style="{StaticResource WebStormPrimaryButton}" 
                    IsDefault="True" Click="OnLoginClicked" Padding="16,6"/>
        </Grid>
    </Grid>
</Window>
