<Window x:Class="GitPort.Dialogs.CommitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GitPort.Models"
        Title="Commit Changes" Height="680" Width="1040"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#152438" Foreground="#E6EEF8"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GitPort;component/Themes/WebStormTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Left Changes & Commit Box, Right Diff Viewer -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Top Header -->
        <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✔ " Foreground="#7EC7A6" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Commit Changes to: " Foreground="#8FA8C4" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="#152438" BorderBrush="#00B8E5" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="4,0,0,0">
                        <TextBlock x:Name="TxtBranchName" Text="main" Foreground="#00B8E5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Background="#1B3454" BorderBrush="#00B8E5" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFilesSummaryBadge" Text="0 files selected" Foreground="#00B8E5" FontWeight="Bold" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 1: Split Content: Left Changes List & Message, Right Diff Preview -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Files & Commit Message (420px) -->
                <ColumnDefinition Width="420" MinWidth="320"/>
                <!-- Splitter -->
                <ColumnDefinition Width="6"/>
                <!-- Right: Diff Preview (*) -->
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Changes List & Commit Message Box -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Changed Files Explorer (60%) -->
                    <RowDefinition Height="*" MinHeight="180"/>
                    <!-- Splitter -->
                    <RowDefinition Height="6"/>
                    <!-- Commit Message Box (40%) -->
                    <RowDefinition Height="200" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- TOP: Changed Files List -->
                <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Select All / Unselect All -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CHANGED FILES" FontWeight="Bold" FontSize="11" Foreground="#8FA8C4" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Select All" Style="{StaticResource WebStormGhostButton}" Click="OnSelectAllClicked" Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="Unselect All" Style="{StaticResource WebStormGhostButton}" Click="OnUnselectAllClicked" Padding="6,2" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- Changes ListView -->
                        <ListView x:Name="ChangesListView" Grid.Row="1" Background="#152438" BorderBrush="#293E5C" BorderThickness="1"
                                  SelectionMode="Single" SelectionChanged="OnSelectedFileChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Click="OnFileCheckboxClicked"/>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1" CornerRadius="2" Padding="4,1" Margin="0,0,8,0" Width="18">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E324C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="M">
                                                            <Setter Property="Background" Value="#1B3454"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="A">
                                                            <Setter Property="Background" Value="#1A3D34"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="D">
                                                            <Setter Property="Background" Value="#3D1E24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="?">
                                                            <Setter Property="Background" Value="#293E5C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8FA8C4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="M">
                                                                <Setter Property="Foreground" Value="#00B8E5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="A">
                                                                <Setter Property="Foreground" Value="#7EC7A6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="D">
                                                                <Setter Property="Foreground" Value="#F48771"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="?">
                                                                <Setter Property="Foreground" Value="#DCDFE4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- File Path -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Directory}" Foreground="#8FA8C4" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- No Changes Alert -->
                        <Border x:Name="PanelNoChanges" Grid.Row="1" Background="#152438" CornerRadius="4" Visibility="Collapsed" Padding="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="No changed files in working tree" FontSize="13" FontWeight="SemiBold" Foreground="#8FA8C4" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Small Splitter -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

                <!-- BOTTOM: Commit Message Box -->
                <Border Grid.Row="2" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="COMMIT MESSAGE" FontWeight="Bold" FontSize="11" Foreground="#8FA8C4" Margin="0,0,0,6"/>

                        <!-- Commit Message TextBox -->
                        <TextBox x:Name="TxtCommitMessage" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#152438" Foreground="#E6EEF8" BorderBrush="#293E5C" BorderThickness="1"
                                 Padding="8" FontSize="12" FontFamily="Consolas, Segoe UI"
                                 PreviewKeyDown="OnMessagePreviewKeyDown"/>

                        <!-- Amend Checkbox -->
                        <CheckBox x:Name="ChkAmend" Grid.Row="2" Content="Amend commit" Foreground="#8FA8C4" Margin="0,6,0,0"
                                  Checked="OnAmendCheckedChanged" Unchecked="OnAmendCheckedChanged"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Column Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- RIGHT: Diff Inspector -->
            <Border Grid.Column="2" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Diff Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Diff View -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄 " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDiffFilePath" Text="Select a file to inspect diff" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔍 Open in Diff Window..." Style="{StaticResource WebStormGhostButton}" 
                                Click="OnOpenInDiffWindowClicked" FontSize="11" Padding="8,2"/>
                    </Grid>

                    <!-- Formatted Diff View (Unified) -->
                    <Border Grid.Row="1" Background="#152438" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                            <ItemsControl x:Name="UnifiedDiffItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:DiffLineItem}">
                                        <Border Background="{Binding BackgroundBrush}" Padding="6,1" SnapsToDevicePixels="True">
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" 
                                                       FontFamily="Consolas, JetBrains Mono, monospace" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: Footer / Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status / Validation -->
            <TextBlock x:Name="TxtStatusMessage" Grid.Column="0" Text="" Foreground="#F48771" FontSize="11" VerticalAlignment="Center"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource WebStormGhostButton}" 
                        IsCancel="True" Click="OnCancelClicked" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="BtnCommitAndPush" Content="Commit and Push..." Style="{StaticResource WebStormButton}" 
                        Click="OnCommitAndPushClicked" Padding="14,6" Margin="0,0,8,0"
                        ToolTip="Commit selected changes and immediately open the Push dialog (Ctrl+Alt+K)"/>
                <Button x:Name="BtnCommit" Content="Commit" Style="{StaticResource WebStormPrimaryButton}" 
                        Click="OnCommitClicked" Padding="18,6"
                        ToolTip="Commit selected changes (Ctrl+Enter)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
