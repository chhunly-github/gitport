<Window x:Class="GitPort.Dialogs.NewWorktreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Git Worktree" Height="400" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E324C" Foreground="#E6EEF8"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Location -->
            <RowDefinition Height="Auto"/>
            <!-- Branch Options -->
            <RowDefinition Height="Auto"/>
            <!-- Options (Open tab) -->
            <RowDefinition Height="Auto"/>
            <!-- Spacer / Buttons -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Create Linked Git Worktree" FontSize="15" FontWeight="SemiBold" Foreground="#E6EEF8"/>
            <TextBlock Text="Work on another branch in a separate folder simultaneously without switching branches." 
                       FontSize="11" Foreground="#8FA8C4" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Location -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Worktree Directory (location on disk):" Margin="0,0,0,6" Foreground="#E6EEF8" FontSize="12" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLocation" Grid.Column="0" Style="{StaticResource WebStormSearchBox}" Height="28"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource WebStormButton}" Click="OnBrowseLocation" Margin="8,0,0,0" Height="28" Padding="12,2"/>
            </Grid>
        </StackPanel>

        <!-- Branch Options -->
        <Border Grid.Row="2" Background="#152438" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Branch Configuration:" Foreground="#E6EEF8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <!-- Option A: Existing Branch -->
                <RadioButton x:Name="RadioExisting" Content="Checkout existing branch:" Foreground="#E6EEF8" FontSize="11"
                             GroupName="BranchChoice" Checked="OnBranchChoiceChanged" Unchecked="OnBranchChoiceChanged" Margin="0,2,0,4"/>
                <ComboBox x:Name="CboExistingBranch" Height="26" Margin="18,0,0,8" IsEditable="True"
                          Background="#1E324C" Foreground="#E6EEF8" BorderBrush="#293E5C"/>

                <!-- Option B: New Branch -->
                <RadioButton x:Name="RadioNew" Content="Create new branch from base ref:" Foreground="#E6EEF8" FontSize="11"
                             GroupName="BranchChoice" Checked="OnBranchChoiceChanged" Unchecked="OnBranchChoiceChanged" Margin="0,2,0,4"/>
                <Grid x:Name="GridNewBranch" Margin="18,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="New Branch Name:" Foreground="#8FA8C4" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtNewBranch" Style="{StaticResource WebStormSearchBox}" Height="26"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Base from (Commit/Branch):" Foreground="#8FA8C4" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtBaseRef" Style="{StaticResource WebStormSearchBox}" Height="26"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Options -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <CheckBox x:Name="ChkOpenTab" Content="Open worktree in new tab immediately" IsChecked="True" Foreground="#8FA8C4" FontSize="11"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" Style="{StaticResource WebStormGhostButton}" Click="OnCancel" Width="80" Height="28" Margin="0,0,8,0"/>
            <Button Content="Create Worktree" Style="{StaticResource WebStormButton}" Click="OnCreate" Width="130" Height="28" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
