<Window x:Class="GitPort.Dialogs.NewWorktreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Worktree" Height="260" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E324C" Foreground="#E6EEF8"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Location -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Worktree Location:" Margin="0,0,0,6" Foreground="#8FA8C4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLocation" Grid.Column="0" Style="{StaticResource WebStormSearchBox}" Height="28"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource WebStormButton}" Click="OnBrowseLocation" Margin="8,0,0,0" Height="28" Padding="12,2"/>
            </Grid>
        </StackPanel>

        <!-- Branch -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Branch Name:" Margin="0,0,0,6" Foreground="#8FA8C4"/>
            <TextBox x:Name="TxtBranch" Style="{StaticResource WebStormSearchBox}" Height="28"/>
        </StackPanel>

        <!-- Base Ref -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Base from (Commit or Branch):" Margin="0,0,0,6" Foreground="#8FA8C4"/>
            <TextBox x:Name="TxtBaseRef" Style="{StaticResource WebStormSearchBox}" Height="28"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" Style="{StaticResource WebStormGhostButton}" Click="OnCancel" Width="80" Height="28" Margin="0,0,8,0"/>
            <Button Content="Create Worktree" Style="{StaticResource WebStormButton}" Click="OnCreate" Width="120" Height="28" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
