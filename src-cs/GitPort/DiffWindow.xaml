<Window x:Class="GitPort.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GitPort.Models"
        Title="WebStorm Diff Viewer - GitPort" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#152438" Foreground="#E6EEF8"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="38"/>
            <!-- Content (Side-by-Side OR Unified) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📄 " FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtFilePath" Text="File Path" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCommitSummary" Text=" (commit)" Foreground="#8FA8C4" Margin="8,0,12,0" VerticalAlignment="Center"/>

                    <!-- Stats Badges -->
                    <Border Background="#1C3B28" CornerRadius="3" Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDiffStatsAdd" Text="+0" Foreground="#98C379" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#3E1F24" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDiffStatsDel" Text="-0" Foreground="#E06C75" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Action Controls -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <RadioButton x:Name="RbSideBySide" Content="⧉ Side-by-Side" IsChecked="True" Foreground="#E6EEF8"
                                 Checked="OnViewModeChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbUnified" Content="☰ Unified" Foreground="#E6EEF8"
                                 Checked="OnViewModeChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Close" Style="{StaticResource WebStormButton}" Click="OnCloseClicked" Height="26" Padding="14,2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- 1. Side-by-Side View -->
            <ListView x:Name="SideBySideListView" Background="#152438" BorderThickness="0"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="Visible">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Height" Value="20"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SideBySideDiffRow}">
                        <Grid Height="20" HorizontalAlignment="Stretch">
                            <!-- Hunk Header -->
                            <Border Background="#1B3454" BorderBrush="#2C4F7C" BorderThickness="0,1" Visibility="{Binding HunkVisibility}">
                                <TextBlock Text="{Binding LeftText}" Foreground="#00B8E5" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Border>

                            <!-- Side-by-side normal row -->
                            <Grid Visibility="{Binding CodeVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left (Base/Old) -->
                                <Grid Grid.Column="0" Background="{Binding LeftBackground}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#1A2C42" BorderBrush="#293E5C" BorderThickness="0,0,1,0" Padding="0,0,6,0">
                                        <TextBlock Text="{Binding LeftLineNumberDisplay}" Foreground="#6882A0"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding LeftSign}" Foreground="{Binding LeftForeground}"
                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LeftText}" Foreground="{Binding LeftForeground}"
                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                               VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="NoWrap"/>
                                </Grid>

                                <!-- Divider -->
                                <Rectangle Grid.Column="1" Fill="#293E5C"/>

                                <!-- Right (Modified/New) -->
                                <Grid Grid.Column="2" Background="{Binding RightBackground}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#1A2C42" BorderBrush="#293E5C" BorderThickness="0,0,1,0" Padding="0,0,6,0">
                                        <TextBlock Text="{Binding RightLineNumberDisplay}" Foreground="#6882A0"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding RightSign}" Foreground="{Binding RightForeground}"
                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RightText}" Foreground="{Binding RightForeground}"
                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                               VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="NoWrap"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 2. Unified Fallback View -->
            <ScrollViewer x:Name="UnifiedScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#152438" Visibility="Collapsed" Padding="8">
                <ItemsControl x:Name="UnifiedItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DiffLineItem}">
                            <Border Background="{Binding BackgroundBrush}" Padding="4,1" Margin="0,0.5">
                                <TextBlock Text="{Binding Text}" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                           Foreground="{Binding TextBrush}" TextWrapping="NoWrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
