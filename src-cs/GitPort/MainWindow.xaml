<Window x:Class="GitPort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:GitPort.Controls"
        xmlns:models="clr-namespace:GitPort.Models"
        Title="GitPort - Git Worktrees &amp; Multi-Repository Workspace" Height="860" Width="1480"
        MinHeight="600" MinWidth="980"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#152438" Foreground="#E6EEF8"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        FontSize="12"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GitPort;component/Themes/WebStormTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- ROW 0: SourceTree-style Repository Tabs Bar -->
            <RowDefinition Height="36"/>
            <!-- ROW 1: Main Content (Repository Catalog OR WebStorm Git Workspace) -->
            <RowDefinition Height="*"/>
            <!-- ROW 2: Status Bar -->
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: SourceTree-style Multi-Repository Tab Strip -->
        <Border Grid.Row="0" Background="#152438" BorderBrush="#293E5C" BorderThickness="0,0,0,1" Padding="6,4,6,0">
            <Grid VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Repositories Catalog Tab (SourceTree style) -->
                <Border x:Name="TabCatalog" Grid.Column="0" BorderBrush="#293E5C" BorderThickness="1,1,1,0"
                        CornerRadius="4,4,0,0" Padding="12,5" Margin="0,0,3,0" Cursor="Hand"
                        MouseLeftButtonDown="OnTabCatalogClicked">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#152438"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ViewCatalog, Path=Visibility}" Value="Visible">
                                    <Setter Property="Background" Value="#1E324C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " Foreground="#E5C07B" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Repositories" FontWeight="SemiBold" Foreground="#E6EEF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Open Repository Tabs (SourceTree style tabs for each open repo) -->
                <ItemsControl x:Name="RepoTabsItemsControl" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:RepoTabItem}">
                            <Border x:Name="TabBorder" BorderBrush="#293E5C" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0"
                                    Padding="10,5" Margin="0,0,3,0" Cursor="Hand"
                                    MouseLeftButtonDown="OnRepoTabClicked"
                                    ContextMenuOpening="OnRepoTabContextMenuOpening">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#152438"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#1E324C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁 " Foreground="#00B8E5" FontSize="11" VerticalAlignment="Center"/>
                                    <!-- Repo Name -->
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E6EEF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <!-- Current Branch Badge -->
                                    <Border Background="#1B3454" CornerRadius="2" Padding="4,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentBranch}" Foreground="#00B8E5" FontSize="10"/>
                                    </Border>
                                    <!-- Close Tab Button (✕) -->
                                    <Button Content="✕" Style="{StaticResource WebStormGhostButton}" Click="OnCloseTabClicked"
                                            Padding="4,0" FontSize="10" Foreground="#8FA8C4" ToolTip="Close Tab"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Right: Add / Open Repository Button (+) -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,4">
                    <Button Content="➕" Style="{StaticResource WebStormGhostButton}" Click="OnOpenRepoClicked"
                            ToolTip="Open Repository as New Tab" Padding="6,2" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: CONTENT AREA -->
        <Grid Grid.Row="1">

            <!-- VIEW 1: SourceTree-style Repository Browser (When Repositories Tab is Active) -->
            <Grid x:Name="ViewCatalog" Background="#152438" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Header with Filter & Action Buttons -->
                    <RowDefinition Height="50"/>
                    <!-- Repository Groups & Cards -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="📁 " FontSize="16" Foreground="#E5C07B" VerticalAlignment="Center"/>
                            <TextBlock Text="LOCAL REPOSITORIES" FontWeight="Bold" FontSize="13" Foreground="#E6EEF8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <TextBox x:Name="TxtCatalogSearch" Grid.Column="1" Style="{StaticResource WebStormSearchBox}"
                                 Width="340" Height="26" HorizontalAlignment="Center" TextChanged="OnCatalogSearchChanged"
                                 Tag="Search all repositories..."/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Grid.Column="2">
                            <Button Content="+ Add Repository" Style="{StaticResource WebStormButton}" Click="OnOpenRepoClicked" Margin="0,0,8,0" Height="26" Padding="10,2"/>
                            <Button Content="📁 New Group" Style="{StaticResource WebStormGhostButton}" Click="OnNewGroupClicked" Margin="0,0,8,0" Height="26" Padding="10,2"/>
                            <Button Content="🧹 Clean Missing" Style="{StaticResource WebStormGhostButton}" Click="OnCleanMissingReposClicked" Height="26" Padding="8,2" ToolTip="Scan and remove missing or deleted repositories from the catalog"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Catalog Content: TreeView of Groups & Repository Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                    <ItemsControl x:Name="CatalogGroupsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RepoGroupItem}">
                                <StackPanel Margin="0,0,0,20">
                                    <!-- Group Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="📁 " Foreground="#E5C07B" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayHeader}" FontWeight="Bold" FontSize="13" Foreground="#E6EEF8" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Repositories Grid / Cards -->
                                    <ItemsControl ItemsSource="{Binding Repositories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:RepoItem}">
                                                <Border Background="#1E324C" BorderBrush="#293E5C" BorderThickness="1" CornerRadius="6"
                                                        Width="340" Height="78" Margin="0,0,12,12" Padding="12,10" Cursor="Hand"
                                                        MouseLeftButtonDown="OnCatalogCardClicked"
                                                        ContextMenuOpening="OnCatalogCardContextMenuOpening">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#00B8E5"/>
                                                                    <Setter Property="Background" Value="#243A59"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Repo Name & Branch -->
                                                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                                            <TextBlock Text="📁 " Foreground="#00B8E5" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <Border Background="#1B3454" CornerRadius="2" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CurrentBranch}" Foreground="#00B8E5" FontSize="10"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Card Action Buttons -->
                                                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                                                            <Button Content="Open Tab" Style="{StaticResource WebStormGhostButton}"
                                                                    Click="OnOpenTabFromCardClicked" Padding="6,1" FontSize="11" Margin="0,0,4,0"/>
                                                            <Button Content="⋯" Style="{StaticResource WebStormGhostButton}"
                                                                    Click="OnCardMenuClicked" Padding="4,1" FontSize="11" ToolTip="Repository Options" Margin="0,0,4,0"/>
                                                            <Button Content="✕" Style="{StaticResource WebStormGhostButton}"
                                                                    Click="OnRemoveRepoFromCardClicked" Padding="5,1" FontSize="10" Foreground="#E06C75" ToolTip="Remove repository from GitPort catalog"/>
                                                        </StackPanel>

                                                        <!-- Path -->
                                                        <TextBlock Text="{Binding Path}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                   Foreground="#8FA8C4" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- VIEW 2: WebStorm Git Workspace for Active Repository Tab -->
            <Grid x:Name="ViewWorkspace" Background="#152438" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Subheader Bar (Repo Info + Subtabs [Log | Working Tree] + Action Buttons) -->
                    <RowDefinition Height="38"/>
                    <!-- Workspace Body (Log View OR Working Tree View) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: Subheader Toolbar -->
                <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Repo Name & Sub-Tabs -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Center: Search Everywhere / Log Filters -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: Git Actions -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Repo Name & Subtabs [Log] / [Working Tree (N)] -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <!-- Repo Title -->
                            <TextBlock x:Name="TxtWorkspaceRepoName" Text="Repository" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- Sub-tabs Container -->
                            <Border Background="#152438" CornerRadius="4" Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Log Subtab Button -->
                                    <Button x:Name="BtnSubtabLog" Style="{StaticResource WebStormGhostButton}" Click="OnSubtabLogClicked"
                                            Padding="10,3" FontWeight="SemiBold" ToolTip="Commit History &amp; DAG Graph">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Log" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Working Tree Subtab Button -->
                                    <Button x:Name="BtnSubtabWorkingTree" Style="{StaticResource WebStormGhostButton}" Click="OnSubtabWorkingTreeClicked"
                                            Padding="10,3" FontWeight="SemiBold" ToolTip="Working Tree Staging &amp; Diff Preview">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📝 " FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Working tree" VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeWorkingTreeCount" Background="#E5C07B" CornerRadius="8" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtWorkingTreeBadge" Text="0" Foreground="#152438" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Center: Filters (Visible in Log view) -->
                        <StackPanel x:Name="PanelLogFilters" Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                            <!-- Branch Filter Dropdown (All Branches v) -->
                            <Button Style="{StaticResource WebStormGhostButton}" Click="OnResetBranchFilter" Padding="4,2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 " Foreground="#8FA8C4" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBranchFilterLabel" Text="All Branches" Foreground="#E6EEF8" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ▾" Foreground="#8FA8C4" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Commit Text/Hash Search -->
                            <TextBox x:Name="TxtCommitFilter" Style="{StaticResource WebStormSearchBox}"
                                     Width="220" VerticalAlignment="Center" TextChanged="OnFilterTextChanged" Height="22"
                                     Tag="Text or hash"/>
                            <Button Content="(.*)" Style="{StaticResource WebStormGhostButton}" Padding="4,1" Margin="4,0,2,0" FontSize="11" ToolTip="Regex"/>
                            <Button Content="Aa" Style="{StaticResource WebStormGhostButton}" Padding="4,1" Margin="0,0,8,0" FontSize="11" ToolTip="Match Case"/>
                            <TextBlock Text="Branch ▾" Foreground="#8FA8C4" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="User ▾" Foreground="#8FA8C4" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="Date ▾" Foreground="#8FA8C4" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="Paths ▾" Foreground="#8FA8C4" VerticalAlignment="Center" Margin="4,0"/>
                        </StackPanel>

                        <!-- Right: Actions (Commit, Fetch, Pull, Push, New Worktree, Refresh) -->
                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="BtnToolbarCommit" Content="✔ Commit..." Style="{StaticResource WebStormGhostButton}" Click="OnToolbarCommitClicked" Margin="0,0,4,0" ToolTip="Commit Changes (Ctrl+K)"/>
                            <Button Content="⬇ Fetch" Style="{StaticResource WebStormGhostButton}" Click="OnFetchAllClicked" Margin="0,0,4,0" ToolTip="Fetch All Remotes"/>
                            <Button x:Name="BtnToolbarPull" Content="⬇ Pull" Style="{StaticResource WebStormGhostButton}" Click="OnPullClicked" Margin="0,0,4,0" ToolTip="Pull Current Branch (Ctrl+T)"/>
                            <Button x:Name="BtnToolbarPush" Content="⬆ Push" Style="{StaticResource WebStormGhostButton}" Click="OnPushClicked" Margin="0,0,4,0" ToolTip="Push Current Branch (Ctrl+Shift+K)"/>
                            <Button Content="🔀 New Worktree" Style="{StaticResource WebStormButton}" Click="OnNewWorktreeClicked" Margin="0,0,4,0"/>
                            <Button Content="⟳" Style="{StaticResource WebStormGhostButton}" Click="OnRefreshClicked" ToolTip="Refresh (F5)" Padding="6,2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 1: WORKSPACE CONTENT (Sub-View A: Log OR Sub-View B: Working Tree) -->
                <Grid Grid.Row="1">

                    <!-- =================================================== -->
                    <!-- SUB-VIEW A: LOG VIEW (WebStorm Graph & Inspector)   -->
                    <!-- =================================================== -->
                    <Grid x:Name="ViewLog" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <!-- Left: WebStorm Branches & Worktrees Tree -->
                            <ColumnDefinition Width="260" MinWidth="180"/>
                            <ColumnDefinition Width="4"/>
                            <!-- Center: WebStorm Git Commit Graph DAG -->
                            <ColumnDefinition Width="*" MinWidth="400"/>
                            <ColumnDefinition Width="4"/>
                            <!-- Right: Compacted Changed Files & Details -->
                            <ColumnDefinition Width="380" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: WebStorm Branches & Worktrees Tree -->
                        <Border Grid.Column="0" Background="#152438" BorderBrush="#293E5C" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,0,1" Padding="8,4">
                                    <TextBox x:Name="TxtBranchSearch" Style="{StaticResource WebStormSearchBox}"
                                             TextChanged="OnBranchSearchChanged" Height="20" FontSize="11" Tag="Branch or tag"/>
                                </Border>

                                <TreeView x:Name="BranchesTreeView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                          SelectedItemChanged="OnBranchSelectionChanged"
                                          MouseDoubleClick="OnBranchTreeDoubleClick"
                                          PreviewMouseRightButtonDown="OnBranchTreePreviewRightClick"
                                          ContextMenuOpening="OnBranchContextMenuOpening"
                                          Padding="4">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="Padding" Value="2,2"/>
                                            <Setter Property="Foreground" Value="#E6EEF8"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ToggleButton x:Name="Expander" Style="{StaticResource ExpandCollapseToggleStyle}"
                                                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                                    <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                                                                </Grid>
                                                            </Border>
                                                            <ItemsPresenter Grid.Row="1" x:Name="ItemsHost" Margin="14,0,0,0"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="HasItems" Value="false">
                                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelection}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type models:GitBranchItem}" ItemsSource="{Binding Children}">
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icons -->
                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                    <!-- Star icon for master/default branch -->
                                                    <TextBlock Text="⭐ " Foreground="#E5C07B" FontSize="10" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStar}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Tag icon for active checkout branch -->
                                                    <TextBlock Text="🏷️ " Foreground="#00B8E5" FontSize="10" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Worktree Icon (only for secondary worktrees) -->
                                                    <TextBlock Text="🔀 " Foreground="#00B8E5" FontSize="11" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWorktree}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Folder Icon -->
                                                    <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:BranchItemKind.Folder}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Branch Glyph for normal branches -->
                                                    <TextBlock Text="🌿 " Foreground="#00B8E5" FontSize="10" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Kind}" Value="{x:Static models:BranchItemKind.Branch}"/>
                                                                            <Condition Binding="{Binding IsStar}" Value="False"/>
                                                                            <Condition Binding="{Binding IsCurrent}" Value="False"/>
                                                                            <Condition Binding="{Binding IsWorktree}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Branch Name -->
                                                <TextBlock Text="{Binding Name}" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#E6EEF8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:BranchItemKind.Category}">
                                                                    <Setter Property="Foreground" Value="#8FA8C4"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Incoming Badge (⬇ 88+) -->
                                                <Border Grid.Column="2" Background="#1E518A" CornerRadius="3" Padding="4,1" Margin="6,0,2,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BadgeText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding BadgeText, Converter={x:Null}}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding BadgeText}" Foreground="#00B8E5" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Border>

                        <!-- SPLITTER 1 -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1E324C"/>

                        <!-- CENTER: WebStorm Git Commit Graph DAG -->
                        <Grid Grid.Column="2" Background="#152438">
                            <ListView x:Name="CommitsListView" Background="Transparent" BorderThickness="0"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionChanged="OnCommitSelectionChanged"
                                      PreviewMouseRightButtonDown="OnCommitPreviewRightClick"
                                      ContextMenuOpening="OnCommitContextMenuOpening">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Height" Value="24"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="#1E518A"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="true"/>
                                                                <Condition Property="IsSelected" Value="false"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:GitCommitItem}">
                                        <Grid Height="24">
                                            <Grid.ColumnDefinitions>
                                                <!-- Col 0: Fixed 56px Graph strip -->
                                                <ColumnDefinition Width="56"/>
                                                <!-- Col 1: Subject (Starts at fixed x=56, ZERO staircase indenting!) -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Col 2: Tag Chips (origin & ly, etc.) -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Col 3: Author (130px) -->
                                                <ColumnDefinition Width="130"/>
                                                <!-- Col 4: Date (110px) -->
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: Vector DAG Graph Control -->
                                            <ctrl:CommitGraphControl Grid.Column="0" CommitItem="{Binding}" LaneWidth="12" Height="24"/>

                                            <!-- Col 1: Subject (Aligned uniformly at x = 56px across all rows!) -->
                                            <TextBlock Grid.Column="1" Text="{Binding Subject}" Foreground="#E6EEF8" FontSize="12"
                                                       VerticalAlignment="Center" Margin="6,0,8,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHead}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Col 2: Delicate Inline Tag Chips (🏷 origin & ly) -->
                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding RefChips}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="🏷 " Foreground="{Binding Foreground}" FontSize="9" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Col 3: Author -->
                                            <TextBlock Grid.Column="3" Text="{Binding Author}" Foreground="#8FA8C4" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>

                                            <!-- Col 4: Date -->
                                            <TextBlock Grid.Column="4" Text="{Binding Date}" Foreground="#8FA8C4" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- SPLITTER 2 -->
                        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#1E324C"/>

                        <!-- RIGHT: WebStorm Commit Files Explorer (Image 2 Matching Design!) -->
                        <Grid Grid.Column="4" Background="#152438">
                            <Grid.RowDefinitions>
                                <!-- Files Header -->
                                <RowDefinition Height="32"/>
                                <!-- Files Tree -->
                                <RowDefinition Height="*"/>
                                <!-- Splitter -->
                                <RowDefinition Height="4"/>
                                <!-- Commit Details Card -->
                                <RowDefinition Height="140" MinHeight="100"/>
                            </Grid.RowDefinitions>

                            <!-- Files Header -->
                            <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,0,1" Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <TextBlock x:Name="TxtFileCountHeader" Text="0 files" FontWeight="SemiBold" FontSize="12" Foreground="#E6EEF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                                        <Button Content="Show Diff" Style="{StaticResource WebStormGhostButton}" Click="OnShowDiffClicked" Padding="8,2" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Compacted Files TreeView with WebStorm Styling (Image 2!) -->
                            <TreeView x:Name="FilesTreeView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                      MouseDoubleClick="OnFilesTreeDoubleClick"
                                      PreviewMouseRightButtonDown="OnFilesTreePreviewRightClick"
                                      ContextMenuOpening="OnFilesTreeContextMenuOpening"
                                      Padding="4" HorizontalContentAlignment="Stretch">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="0,1"/>
                                        <Setter Property="Foreground" Value="#E6EEF8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="2,2" HorizontalAlignment="Stretch">
                                                            <Grid HorizontalAlignment="Stretch">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ToggleButton x:Name="Expander" Style="{StaticResource ExpandCollapseToggleStyle}"
                                                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                                <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter Grid.Row="1" x:Name="ItemsHost" Margin="14,0,0,0"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="HasItems" Value="false">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="#1E518A"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="true"/>
                                                                <Condition Property="IsSelected" Value="false"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid HorizontalAlignment="Stretch" Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Folder or File Icon + Name (Col 0) -->
                                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                <!-- Folder Icon -->
                                                <TextBlock Text="📁 " FontSize="11" Foreground="#E5C07B" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- File Icon -->
                                                <TextBlock Text="📄 " FontSize="11" Foreground="#8FA8C4" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Name -->
                                                <TextBlock Text="{Binding Name}" Foreground="#E6EEF8" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>

                                            <!-- Folder File Count (Col 1, e.g. "4 files", "2 files" from Image 2!) -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayFileCount}" Foreground="#8FA8C4" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Col 2 is empty stretcher (*) -->

                                            <!-- Status Badge (Col 3, Right-Aligned M/A/D from Image 2!) -->
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <!-- SPLITTER 3 -->
                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#1E324C"/>

                            <!-- WebStorm Commit Details Card -->
                            <Border Grid.Row="3" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,1,0,0" Padding="12,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Subject -->
                                        <TextBlock x:Name="TxtDetailSubject" Text="No commit selected" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>

                                        <!-- Hash & Author -->
                                        <TextBlock x:Name="TxtDetailAuthor" Text="" Foreground="#8FA8C4" FontSize="11" Margin="0,4,0,0"/>

                                        <!-- Branch Tags -->
                                        <TextBlock x:Name="TxtDetailBranches" Text="" Foreground="#00B8E5" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- SUB-VIEW B: WORKING TREE VIEW (Staging, WebStorm Side-by-Side Diff, Commit)-->
                    <!-- ========================================================================= -->
                    <Grid x:Name="ViewWorkingTree" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Changed Files Dual-Staging & Commit Box (420px) -->
                            <ColumnDefinition Width="420" MinWidth="320"/>
                            <!-- Splitter -->
                            <ColumnDefinition Width="4"/>
                            <!-- Right: WebStorm Side-by-Side Diff Preview -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Upgraded Staging Workspace & Commit Box -->
                        <Grid Grid.Column="0" Background="#152438">
                            <Grid.RowDefinitions>
                                <!-- Top Staging Actions Toolbar -->
                                <RowDefinition Height="36"/>
                                <!-- Staged Files Section -->
                                <RowDefinition Height="*"/>
                                <!-- Splitter between Staged and Unstaged -->
                                <RowDefinition Height="4"/>
                                <!-- Unstaged Files Section -->
                                <RowDefinition Height="*"/>
                                <!-- Splitter -->
                                <RowDefinition Height="4"/>
                                <!-- Commit Box -->
                                <RowDefinition Height="180" MinHeight="130"/>
                            </Grid.RowDefinitions>

                            <!-- Top Staging Actions Toolbar -->
                            <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,1,1" Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Changed Files Header -->
                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="CHANGED FILES " FontWeight="Bold" FontSize="11" Foreground="#8FA8C4" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtWorkingTreeFileCount" Text="(0)" FontWeight="Bold" FontSize="11" Foreground="#E5C07B" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Better Button Actions -->
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="⬆ Stage All" Style="{StaticResource WebStormButton}" Click="OnStageAllClicked" ToolTip="Stage All Changes (git add -A)" Height="24" Padding="8,1" Margin="0,0,4,0"/>
                                        <Button Content="⬇ Unstage All" Style="{StaticResource WebStormGhostButton}" Click="OnUnstageAllClicked" ToolTip="Unstage All Changes" Height="24" Padding="8,1" Margin="0,0,4,0"/>
                                        <Button Content="↺ Discard" Style="{StaticResource WebStormGhostButton}" Click="OnDiscardSelectedClicked" ToolTip="Discard / Revert Selected Changes" Height="24" Padding="8,1"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 1: STAGED CHANGES -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Staged Subheader -->
                                <Border Grid.Row="0" Background="#232824" BorderBrush="#293E5C" BorderThickness="0,0,1,1" Padding="8,0">
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="✓ STAGED CHANGES " FontWeight="Bold" FontSize="10" Foreground="#98C379" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtStagedCount" Text="(0)" FontWeight="Bold" FontSize="10" Foreground="#98C379" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="Unstage" Style="{StaticResource WebStormGhostButton}" Click="OnUnstageAllClicked"
                                                HorizontalAlignment="Right" Padding="6,0" FontSize="10" Foreground="#8FA8C4"/>
                                    </Grid>
                                </Border>

                                <!-- Staged ListView -->
                                <ListView x:Name="StagedListView" Grid.Row="1" Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="#293E5C"
                                          SelectionChanged="OnStagedSelectionChanged" MouseDoubleClick="OnWorkingTreeFileDoubleClick"
                                          PreviewMouseRightButtonDown="OnWorkingTreePreviewRightClick"
                                          ContextMenuOpening="OnStagedContextMenuOpening" Padding="2">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="4,2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1E518A"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="true"/>
                                                                    <Condition Property="IsSelected" Value="false"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:WorkingTreeItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox: Click to unstage -->
                                                <CheckBox Grid.Column="0" IsChecked="True" Click="OnItemStageCheckboxClicked"
                                                          VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Click to Unstage"/>

                                                <!-- Status Badge (M, A, D) -->
                                                <Border Grid.Column="1" Background="#1A2C42" CornerRadius="2" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="10"/>
                                                </Border>

                                                <!-- File Name & Path -->
                                                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayDirectory}" Foreground="#8FA8C4" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Quick Unstage Button -->
                                                <Button Grid.Column="3" Content="-" Style="{StaticResource WebStormGhostButton}" Click="OnUnstageItemClicked"
                                                        Padding="4,0" FontSize="11" ToolTip="Unstage this file"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- SPLITTER -->
                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#1E324C"/>

                            <!-- SECTION 2: UNSTAGED CHANGES -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Unstaged Subheader -->
                                <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,1,1" Padding="8,0">
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="☐ UNSTAGED CHANGES " FontWeight="Bold" FontSize="10" Foreground="#E5C07B" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtUnstagedCount" Text="(0)" FontWeight="Bold" FontSize="10" Foreground="#E5C07B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="+ Stage" Style="{StaticResource WebStormGhostButton}" Click="OnStageAllClicked"
                                                HorizontalAlignment="Right" Padding="6,0" FontSize="10" Foreground="#8FA8C4"/>
                                    </Grid>
                                </Border>

                                <!-- Unstaged ListView -->
                                <ListView x:Name="UnstagedListView" Grid.Row="1" Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="#293E5C"
                                          SelectionChanged="OnUnstagedSelectionChanged" MouseDoubleClick="OnWorkingTreeFileDoubleClick"
                                          PreviewMouseRightButtonDown="OnWorkingTreePreviewRightClick"
                                          ContextMenuOpening="OnUnstagedContextMenuOpening" Padding="2">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="4,2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1E518A"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="true"/>
                                                                    <Condition Property="IsSelected" Value="false"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:WorkingTreeItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox: Click to stage -->
                                                <CheckBox Grid.Column="0" IsChecked="False" Click="OnItemStageCheckboxClicked"
                                                          VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Click to Stage"/>

                                                <!-- Status Badge (M, A, D, U) -->
                                                <Border Grid.Column="1" Background="#1A2C42" CornerRadius="2" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="10"/>
                                                </Border>

                                                <!-- File Name & Path -->
                                                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#E6EEF8" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayDirectory}" Foreground="#8FA8C4" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Quick Stage Button -->
                                                <Button Grid.Column="3" Content="+" Style="{StaticResource WebStormGhostButton}" Click="OnStageItemClicked"
                                                        Padding="4,0" FontSize="11" ToolTip="Stage this file"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- SPLITTER -->
                            <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" Background="#1E324C"/>

                            <!-- Commit Message Box & Commit Button -->
                            <Border Grid.Row="5" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,1,1,0" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Section Label -->
                                    <TextBlock Grid.Row="0" Text="COMMIT MESSAGE" FontWeight="Bold" FontSize="11" Foreground="#8FA8C4" Margin="0,0,0,6"/>

                                    <!-- Commit Message TextBox -->
                                    <TextBox x:Name="TxtCommitMessage" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                                             Background="#152438" Foreground="#E6EEF8" BorderBrush="#293E5C" BorderThickness="1"
                                             Padding="8" FontSize="12" FontFamily="Consolas, Segoe UI"
                                             PreviewKeyDown="OnCommitMessagePreviewKeyDown"/>

                                    <!-- Commit Footer -->
                                    <Grid Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Amend Checkbox -->
                                        <CheckBox x:Name="ChkAmend" Grid.Column="0" Content="Amend" Foreground="#8FA8C4" VerticalAlignment="Center" FontSize="11"/>

                                        <!-- Shortcut hint -->
                                        <TextBlock Grid.Column="1" Text="Ctrl+Enter" Foreground="#6882A0" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                                        <!-- Commit Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="Dialog..." Style="{StaticResource WebStormGhostButton}"
                                                    Click="OnToolbarCommitClicked" Height="26" Padding="8,2" Margin="0,0,4,0" ToolTip="Open WebStorm Commit Dialog (Ctrl+K)"/>
                                            <Button x:Name="BtnCommit" Content="Commit" Style="{StaticResource WebStormButton}"
                                                    Click="OnCommitClicked" Height="26" Padding="14,2" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- SPLITTER -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1E324C"/>

                        <!-- RIGHT: WEBSTORM SIDE-BY-SIDE DIFF PREVIEW -->
                        <Grid Grid.Column="2" Background="#152438">
                            <Grid.RowDefinitions>
                                <!-- Diff Header -->
                                <RowDefinition Height="36"/>
                                <!-- Diff Content -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Diff Header -->
                            <Border Grid.Row="0" Background="#1E324C" BorderBrush="#293E5C" BorderThickness="0,0,0,1" Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- File Title + Stats Badges -->
                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDiffFileTitle" Text="DIFF PREVIEW - Select a changed file" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                        <!-- Additions badge -->
                                        <Border x:Name="BadgeDiffAdd" Background="#1C3B28" CornerRadius="3" Padding="5,1" Margin="8,0,4,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDiffStatsAdd" Text="+0" Foreground="#98C379" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <!-- Deletions badge -->
                                        <Border x:Name="BadgeDiffDel" Background="#3E1F24" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtDiffStatsDel" Text="-0" Foreground="#E06C75" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Switchers: Mode (Unstaged vs Staged) + Layout (Side-by-Side vs Unified) -->
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                        <RadioButton x:Name="RbDiffUnstaged" Content="Unstaged" IsChecked="True" Foreground="#E6EEF8"
                                                     Checked="OnDiffModeChanged" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="RbDiffStaged" Content="Staged" Foreground="#E6EEF8"
                                                     Checked="OnDiffModeChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <Border Background="#152438" CornerRadius="4" Padding="2" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RbDiffSideBySide" Content="⧉ Side-by-Side" IsChecked="True" Foreground="#E6EEF8"
                                                             Checked="OnDiffLayoutChanged" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                                <RadioButton x:Name="RbDiffUnified" Content="☰ Unified" Foreground="#E6EEF8"
                                                             Checked="OnDiffLayoutChanged" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Diff Content Area (Side-by-Side OR Unified) -->
                            <Grid Grid.Row="1">
                                <!-- 1. WebStorm Side-by-Side Diff View -->
                                <ListView x:Name="WorkingTreeSideBySideListView" Background="#152438" BorderThickness="0"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Visibility="Visible">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Height" Value="20"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SideBySideDiffRow}">
                                            <Grid Height="20" HorizontalAlignment="Stretch">
                                                <!-- Hunk Header Banner -->
                                                <Border Background="#1B3454" BorderBrush="#2C4F7C" BorderThickness="0,1" Visibility="{Binding HunkVisibility}">
                                                    <TextBlock Text="{Binding HunkHeaderText}" Foreground="#00B8E5" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Border>

                                                <!-- Normal side-by-side row -->
                                                <Grid Visibility="{Binding CodeVisibility}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left (Base / Old) -->
                                                    <Grid Grid.Column="0" Background="{Binding LeftBackground}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#1A2C42" BorderBrush="#293E5C" BorderThickness="0,0,1,0" Padding="0,0,6,0">
                                                            <TextBlock Text="{Binding LeftLineNumberDisplay}" Foreground="#6882A0"
                                                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding LeftSign}" Foreground="{Binding LeftForeground}"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding LeftText}" Foreground="{Binding LeftForeground}"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LeftText}"/>
                                                    </Grid>

                                                    <!-- Divider -->
                                                    <Rectangle Grid.Column="1" Fill="#293E5C"/>

                                                    <!-- Right (Modified / New) -->
                                                    <Grid Grid.Column="2" Background="{Binding RightBackground}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#1A2C42" BorderBrush="#293E5C" BorderThickness="0,0,1,0" Padding="0,0,6,0">
                                                            <TextBlock Text="{Binding RightLineNumberDisplay}" Foreground="#6882A0"
                                                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding RightSign}" Foreground="{Binding RightForeground}"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding RightText}" Foreground="{Binding RightForeground}"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding RightText}"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- 2. Unified Diff Fallback -->
                                <ScrollViewer x:Name="WorkingTreeUnifiedScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="#152438" Visibility="Collapsed" Padding="8">
                                    <ItemsControl x:Name="WorkingTreeUnifiedItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:DiffLineItem}">
                                                <Border Background="{Binding BackgroundBrush}" Padding="4,1" Margin="0,0.5">
                                                    <TextBlock Text="{Binding Text}" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11"
                                                               Foreground="{Binding TextBrush}" TextWrapping="NoWrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ROW 2: Status Bar -->
        <Border Grid.Row="2" Background="#152438" BorderBrush="#293E5C" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🔀 " Foreground="#00B8E5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusBranch" Text="ly" FontWeight="SemiBold" Foreground="#E6EEF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="|" Foreground="#293E5C" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusMessage" Text="Ready" Foreground="#8FA8C4" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="|" Foreground="#293E5C" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusRepo" Text="" Foreground="#6882A0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <TextBlock Text="Embedded Git" Foreground="#8FA8C4" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="UTF-8" Foreground="#8FA8C4" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
